{
  "name": "gulou",
  "version": "0.29.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node scripts/smoke.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "assets:building": "node scripts/export-building.mjs",
    "assets:landmarks": "node scripts/export-landmarks.mjs",
    "assets:student": "node scripts/build-student.mjs",
    "test:expansion": "node scripts/phase2-check.mjs",
    "test:campus": "node scripts/phase3-check.mjs",
    "test:environment": "node --experimental-strip-types scripts/environment-check.mjs",
    "build:pages": "tsc --noEmit && vite build --base=/gulou/",
    "test:audio": "node --experimental-strip-types scripts/audio-check.mjs",
    "test:mobile": "node scripts/phase4-check.mjs",
    "assets:students": "node scripts/build-student.mjs && node scripts/build-student.mjs --female",
    "test:scenic": "node scripts/scenic-check.mjs",
    "test:gate-photo": "node scripts/gate-photo-check.mjs",
    "test:football": "node scripts/football-check.mjs",
    "test:flight-wardrobe": "node scripts/phase8-check.mjs",
    "test:courtyard": "node scripts/phase9-check.mjs",
    "test:flight-performance": "node scripts/flight-performance.mjs",
    "test:buildings": "node scripts/phase10-check.mjs",
    "test:access": "node scripts/access-check.mjs",
    "test:dormitories": "node scripts/dormitory-check.mjs",
    "test:geometry": "node scripts/geometry-check.mjs",
    "test:amenities": "node scripts/phase11-check.mjs",
    "test:south-roads": "node scripts/south-road-check.mjs",
    "test:street-trees": "node scripts/street-tree-check.mjs",
    "test:directory": "node scripts/directory-check.mjs",
    "test:songlin": "node scripts/songlin-check.mjs",
    "test:seating": "node scripts/seating-check.mjs",
    "test:refinement": "node scripts/refinement-check.mjs",
    "test:landmarks-riding": "node scripts/phase18-check.mjs",
    "test:jump-stories": "node scripts/phase19-check.mjs",
    "test:east-teaching": "node scripts/phase20-check.mjs",
    "test:library-complex": "node scripts/phase21-check.mjs",
    "test:sports": "node scripts/phase22-check.mjs",
    "test:teaching-parking": "node scripts/phase23-check.mjs",
    "test:fei-yimin": "node scripts/phase25-check.mjs",
    "test:boundaries": "node scripts/phase26-check.mjs",
    "test:traffic": "node --experimental-transform-types scripts/street-traffic-check.mjs",
    "test:street-crossings": "node scripts/street-crossings-check.mjs",
    "test:roof-geometry": "node --experimental-strip-types scripts/building-roof-check.mjs",
    "test:roofs": "node scripts/phase27-check.mjs",
    "test:south-teaching": "node scripts/phase28-check.mjs",
    "test:library-entrances": "node scripts/phase29-check.mjs",
    "test:museum-facade": "node scripts/phase30-check.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9"
  }
}
