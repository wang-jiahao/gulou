{
  "name": "gulou",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node scripts/smoke.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "assets:building": "node scripts/export-building.mjs",
    "assets:landmarks": "node scripts/export-landmarks.mjs",
    "assets:student": "node scripts/build-student.mjs",
    "test:expansion": "node scripts/phase2-check.mjs",
    "test:campus": "node scripts/phase3-check.mjs",
    "test:environment": "node --experimental-strip-types scripts/environment-check.mjs",
    "build:pages": "tsc --noEmit && vite build --base=/gulou/",
    "test:audio": "node --experimental-strip-types scripts/audio-check.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9"
  }
}
